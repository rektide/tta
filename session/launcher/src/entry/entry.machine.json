{
  "id": "entry_attempt",
  "initial": "active",
  "states": {
    "active": {
      "id": "active",
      "initial": "bind_target",
      "on": {
        "stop": { "target": "#stopped" },
        "cancel": { "target": "#stopped" }
      },
      "states": {
        "bind_target": {
          "id": "bind_target",
          "initial": "context_read",
          "states": {
            "context_read": {
              "id": "context_read",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "read_context" } }],
              "on": { "observed": { "target": "#context_policy" }, "supplied": { "target": "#bind_registry" } }
            },
            "context_policy": {
              "id": "context_policy",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "apply_context_policy" } }],
              "on": { "context_policy": [
                { "guard": { "type": "needs_endpoint_identity" }, "target": "#endpoint_read" },
                { "target": "#registry_read" }
              ] }
            },
            "endpoint_read": {
              "id": "endpoint_read",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "read_endpoint_identity" } }],
              "on": { "observed": { "target": "#registry_read" } }
            },
            "registry_read": {
              "id": "registry_read",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "read_registry" } }],
              "on": { "observed": { "target": "#bind_registry" } }
            },
            "bind_registry": {
              "id": "bind_registry",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "validate_registry" } }],
              "on": { "validated": { "target": "#select" } }
            }
          }
        },
        "select": {
          "id": "select",
          "initial": "sessions_read",
          "states": {
            "sessions_read": {
              "id": "sessions_read",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "read_selection_sessions" } }],
              "on": { "observed": { "target": "#sessions_rank" } }
            },
            "sessions_rank": {
              "id": "sessions_rank",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "rank_sessions" } }],
              "on": {
                "unique": { "target": "#prepare_view" },
                "empty": { "target": "#project_scope" }
              }
            },
            "project_scope": {
              "id": "project_scope",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "scope_projects" } }],
              "on": { "scoped": { "target": "#projects_read" } }
            },
            "projects_read": {
              "id": "projects_read",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "read_projects" } }],
              "on": {
                "observed_projects": [
                  { "guard": { "type": "more_roots" }, "target": "projects_read", "reenter": true },
                  { "target": "#projects_rank" }
                ]
              }
            },
            "projects_rank": {
              "id": "projects_rank",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "rank_projects" } }],
              "on": {
                "project_unique": { "target": "#prepare_start" },
                "project_empty": { "target": "#prepare_create" }
              }
            }
          }
        },
        "prepare_view": {
          "id": "prepare_view",
          "initial": "view_policy",
          "states": {
            "view_policy": {
              "id": "view_policy",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "settle_view" } }],
              "on": {
                "view_policy": [
                  { "guard": { "type": "independent" }, "target": "#open_view" },
                  { "target": "#enter_view" }
                ]
              }
            },
            "open_view": {
              "id": "open_view",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "plan_open_view" } }],
              "on": { "prepared": { "target": "#planned" } }
            },
            "enter_view": {
              "id": "enter_view",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "plan_enter_view" } }],
              "on": { "prepared": { "target": "#planned" } }
            }
          }
        },
        "prepare_start": {
          "id": "prepare_start",
          "entry": [{ "type": "@xstate.emit", "event": { "type": "prepare_start" } }],
          "on": { "prepared": { "target": "#planned" } }
        },
        "prepare_create": {
          "id": "prepare_create",
          "initial": "create_policy",
          "states": {
            "create_policy": {
              "id": "create_policy",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "create_policy" } }],
              "on": { "eligible": { "target": "#destination_read" } }
            },
            "destination_read": {
              "id": "destination_read",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "read_destination" } }],
              "on": { "observed": { "target": "#generator_spec" } }
            },
            "generator_spec": {
              "id": "generator_spec",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "validate_generator" } }],
              "on": {
                "validated_generator": [
                  { "guard": { "type": "needs_defaults" }, "target": "#defaults_read" },
                  { "target": "#creation" }
                ]
              }
            },
            "defaults_read": {
              "id": "defaults_read",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "read_defaults" } }],
              "on": { "observed": { "target": "#creation" } }
            },
            "creation": {
              "id": "creation",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "prepare_creation" } }],
              "on": { "prepared": { "target": "#planned" } }
            }
          }
        },
        "planned": {
          "id": "planned",
          "on": { "export": { "target": "#bind_action" } }
        },
        "bind_action": {
          "id": "bind_action",
          "initial": "binding_read",
          "states": {
            "binding_read": {
              "id": "binding_read",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "read_binding_sessions" } }],
              "on": {
                "binding_observed": [
                  { "guard": { "type": "needs_binding_evidence" }, "target": "#binding_evidence" },
                  { "target": "#binding_check" }
                ]
              }
            },
            "binding_evidence": {
              "id": "binding_evidence",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "read_binding_evidence" } }],
              "on": { "observed": { "target": "#binding_check" } }
            },
            "binding_check": {
              "id": "binding_check",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "check_binding" } }],
              "on": { "checked": { "target": "#binding_lower" } }
            },
            "binding_lower": {
              "id": "binding_lower",
              "entry": [{ "type": "@xstate.emit", "event": { "type": "bind_operation" } }],
              "on": { "bound": { "target": "#export_action" } }
            }
          }
        },
        "export_action": {
          "id": "export_action",
          "entry": [{ "type": "@xstate.emit", "event": { "type": "export_action" } }],
          "on": { "exported": { "target": "#exported" } }
        }
      }
    },
    "exported": { "id": "exported", "type": "final" },
    "stopped": { "id": "stopped", "type": "final" }
  }
}
