{
  "id": "tta-entry",
  "initial": "sessions",
  "context": null,
  "states": {
    "sessions": {
      "id": "sessions",
      "on": { "observed": { "target": "resolve" } }
    },
    "resolve": {
      "id": "resolve",
      "on": {
        "projects_needed": { "target": "projects" },
        "destination_needed": { "target": "destination" },
        "resolved": [
          { "guard": { "type": "needs_defaults" }, "target": "defaults" },
          { "guard": { "type": "needs_satellite" }, "target": "fresh_sessions" },
          { "target": "prepare" }
        ]
      }
    },
    "projects": {
      "id": "projects",
      "on": { "observed": { "target": "resolve" } }
    },
    "destination": {
      "id": "destination",
      "on": { "observed": { "target": "resolve" } }
    },
    "defaults": {
      "id": "defaults",
      "on": { "observed": { "target": "resolve" } }
    },
    "fresh_sessions": {
      "id": "fresh_sessions",
      "on": { "observed": { "target": "prepare" } }
    },
    "prepare": {
      "id": "prepare",
      "on": { "prepared": { "target": "ready" } }
    },
    "ready": { "id": "ready", "type": "final" }
  }
}
